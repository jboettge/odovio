<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CarPlay «Driving Task» (Fahrt starten/beenden, Tanken). Auf Geräten erst nach Freischaltung durch Apple
     nutzbar; bis dahin nur in der Debug-Konfiguration (Simulator), siehe docs/TESTFLIGHT.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>
