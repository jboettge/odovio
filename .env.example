# Passwörter: openssl rand -hex 32
# Owner (Migration, Backup)
DB_PASSWORD=
# App-Rolle der API (keine Owner-/Löschrechte)
APP_DB_PASSWORD=

# Netzwerk: nur der Reverse Proxy (Caddy/OPNsense) soll die API erreichen
# z. B. IP der Docker-VM, zusätzlich Firewall auf OPNsense beschränken
API_BIND=127.0.0.1
API_PORT=8085
# IP des Reverse Proxy
FORWARDED_ALLOW_IPS=127.0.0.1

# Keycloak
OIDC_ISSUER=https://id.j-mb.net/realms/<realm>
OIDC_CLIENT_ID=fahrzeugbuch-ios
# Web-Frontend (öffentlicher Client, PKCE); immer als azp zugelassen.
# Nur dort: Mitgliederverwaltung und Steuerparameter
OIDC_WEB_CLIENT_ID=fahrzeugbuch-web
# optional: zusätzlich aud prüfen (Audience-Mapper nötig)
OIDC_AUDIENCE=
# optional: weitere Clients (Komma-getrennt), z. B. für Skripte
OIDC_ALLOWED_AZP=
OIDC_REQUIRED_ROLE=fahrzeugbuch-user

# Mandanten aus Keycloak-Gruppen: /fahrzeugbuch/<mandant> (schreiben), /fahrzeugbuch/<mandant>/lesen,
# /fahrzeugbuch/<mandant>/admin (verwalten inkl. schreiben)
TENANT_GROUP_PREFIX=/fahrzeugbuch/
# nur Einzelbetrieb; dann OIDC_REQUIRED_ROLE setzen!
DEFAULT_TENANT=

# Mitgliederverwaltung über die Keycloak-Admin-API (optional; leer = nur Anzeige der Akteure aus dem Journal)
# Service-Account-Client anlegen: keycloak/setup-client.sh mit CREATE_ADMIN_API=1 (gibt das Secret aus)
# Basis-URL von Keycloak; leer → aus OIDC_ISSUER
KC_ADMIN_URL=
# Realm der Benutzer/Gruppen; leer → aus OIDC_ISSUER
KC_ADMIN_REALM=
KC_ADMIN_CLIENT_ID=
KC_ADMIN_CLIENT_SECRET=
# Timeout je Anfrage an die Admin-API (Sekunden)
KC_ADMIN_TIMEOUT_S=5

# Revisionssicherheit: Ed25519-Schlüssel für signierte Kettenanker (NICHT in der DB ablegen)
# erzeugen: openssl rand -base64 32
ANCHOR_SIGNING_KEY=
# nach einem Schlüsselwechsel: alte Public Keys (Base64, raw 32 Byte, kommagetrennt), damit alte Anker gültig
# bleiben; Public Key des aktuellen Schlüssels: GET /api/t/<mandant>/audit/anchors → public_key
ANCHOR_PUBLIC_KEYS=
ANCHOR_INTERVAL_MIN=60
# Integritätsprüfung inkrementell; Vollprüfung spätestens nach dieser Zeit (Sekunden) bzw. mit ?full=1
VERIFY_FULL_INTERVAL_S=86400
# Zeitzone für Monatszuordnung, Monatsabschluss und Berichte
APP_TIMEZONE=Europe/Zurich

MAX_BODY_BYTES=1048576
# Belege (Fotos/PDF, PUT …/attachments/{id}/blob): eigenes Body-Limit, max. 8 MiB
# Reverse Proxy (Caddy/OPNsense) muss Bodies dieser Grösse durchlassen
MAX_UPLOAD_BYTES=8388608
# Speicherkontingent für Belege je Mandant (MB); überschritten → 507
ATTACHMENT_QUOTA_MB=2048
DOCS_ENABLED=0

# ---------- Intelligente Dienste (optional, leer = aus) ----------
# Die API ist im internen Netz und im default-Netz; externe Container per Host-IP
# oder http://host.docker.internal:<port> (Port auf dem Docker-Host veröffentlicht).
# OSRM (Map-Matching/Route), z. B. http://host.docker.internal:5000
OSRM_URL=
OSRM_PROFILE=driving
# max. Punkte je /match-Anfrage, muss zu osrm-routed --max-matching-size passen
OSRM_MAX_MATCHING_SIZE=100
# Photon (Reverse-Geocoding); mit Compose-Profil "geo": http://photon:2322
PHOTON_URL=
# vLLM (OpenAI-kompatibel), z. B. http://host.docker.internal:8000/v1
VLLM_URL=
VLLM_MODEL=qwen3.5-9b
# nur falls vLLM mit --api-key gestartet wurde
VLLM_API_KEY=
# Bildauswertung von Belegen (Zapfsäule/Quittung/Tacho) mit einem Vision-Modell
# URL leer → VLLM_URL; Modell leer → Bildauswertung aus
VLLM_VISION_URL=
VLLM_VISION_MODEL=
# Timeouts in Sekunden
GEO_TIMEOUT_S=5
LLM_TIMEOUT_S=10
# Rate-Limits je Benutzer und Minute
INTEL_RATE_SUGGEST=60
INTEL_RATE_GEO=30
INTEL_RATE_SCAN=20
# je Benutzer und Minute: PDF/CSV/Jahresbericht, Integritätsprüfung, Vollabgleich (/changes?since=0)
RATE_REPORTS=20
RATE_VERIFY=10
RATE_FULL_SYNC=10
# je Benutzer und Minute: Aktivitäts-Feed, Mitgliederliste/-änderungen
RATE_ACTIVITY=60
RATE_MEMBERS=30
# je Dienst (OSRM, Photon, LLM, Vision, Keycloak-Admin): gleichzeitige Anfragen (voll → sofort 503) und Circuit-Breaker
UPSTREAM_CONCURRENCY=4
UPSTREAM_BREAKER_FAILURES=3
UPSTREAM_BREAKER_OPEN_S=30
# n8n-Webhook (z. B. Monat abgeschlossen → Paperless); folgt keinen Weiterleitungen
N8N_WEBHOOK_URL=
# Signatur: Header X-Fahrzeugbuch-Signature = "sha256=" + HMAC-SHA256(Secret, Body) – in n8n prüfen
# erzeugen: openssl rand -hex 32
N8N_WEBHOOK_SECRET=
# Kanton für Steuerparameter, z. B. ZH
TAX_CANTON=
