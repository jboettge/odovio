# Passwörter: openssl rand -hex 32
# Owner (Migration, Backup)
DB_PASSWORD=
# App-Rolle der API (keine Owner-/Löschrechte)
APP_DB_PASSWORD=

# Netzwerk: nur der Reverse Proxy (Caddy/OPNsense) soll die API erreichen
# z. B. IP der Docker-VM, zusätzlich Firewall auf OPNsense beschränken
API_BIND=127.0.0.1
API_PORT=8085
# IP des Reverse Proxy, wie der API-Container sie sieht (nur von dort wird X-Forwarded-For/-Proto übernommen;
# nie "*"). Caddy auf dem Docker-Host → Gateway des Docker-Netzes (docker network inspect …), nicht 127.0.0.1.
# Falsch → Sicherheits-Log config_warning «X-Forwarded-For von nicht vertrautem Peer …»; alle Clients teilen dann
# die Proxy-IP (Rate-Limits gemeinsam).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Härtung ----------
# erlaubte Host-Header (kommagetrennt, "*.domain" möglich); 127.0.0.1/localhost immer (Healthcheck)
ALLOWED_HOSTS=www.odovio.ch,localhost
# Cross-Origin nur für diese exakten Origins (leer = keine; Web-Frontend läuft auf derselben Origin)
CORS_ORIGINS=
# HSTS auch ohne erkanntes HTTPS senden (normal: automatisch bei X-Forwarded-Proto=https vom Proxy)
FORCE_HSTS=0
# Rate-Limits je Client-IP und Minute (Token-Bucket, Burst ¼; RATE_<KAT>_BURST überschreibt)
RATE_IP_PER_MIN=600
# unauthentifiziert: /auth/config, /health
RATE_PUBLIC_PER_MIN=120
# Web-Frontend (SPA, Assets)
RATE_WEB_PER_MIN=3000
# zusätzlich je angemeldetem Benutzer
RATE_USER_PER_MIN=1200
# Brute-Force: so viele 401 je IP bzw. 403 (fremder Mandant)/404 (fremde IDs) je IP+Benutzer im Fenster
# → IP gesperrt (429), wiederholt mit längerer Sperre (Sekunden)
BRUTE_401_THRESHOLD=20
BRUTE_403_THRESHOLD=30
BRUTE_WINDOW_S=300
BRUTE_BACKOFF_S=300,900,3600
# nie sperren/IP-limitieren (CIDRs, z. B. LAN-Monitoring); der Proxy selbst gehört NICHT hierher,
# solange er X-Forwarded-For setzt (sonst wären alle Clients ausgenommen)
SECURITY_ALLOWLIST=
# maximale Lebensdauer eines Access-Tokens (exp − iat), Sekunden
MAX_TOKEN_LIFETIME_S=3600
# JSON-Bodies: maximale Verschachtelung/Elemente
JSON_MAX_DEPTH=32
JSON_MAX_ITEMS=100000
# 1 (Standard) → Start abbrechen bei unsicherer Konfiguration (Warnungen: Sicherheits-Log, event=config_warning);
# 0 nur vorübergehend zur Fehlersuche
STRICT_CONFIG=1
# uvicorn: gleichzeitige Verbindungen JE WORKER (darüber 503)
UVICORN_LIMIT_CONCURRENCY=200

# ---------- Skalierung (ein Host: mehr Kerne/RAM) ----------
# Worker-Prozesse je Container: 1 | N | auto (= min(2 × API_CPUS, 16); Empfehlung 1 Worker je 0.5–1 vCPU).
# > 1 NUR mit STATE_BACKEND=redis (Valkey, Standard) und PostgreSQL – sonst Startabbruch.
WEB_CONCURRENCY=1
# redis (Standard: Valkey, gemeinsame Rate-Limits/Sperren/Circuit-Breaker aller Worker) | memory
STATE_BACKEND=redis
# Valkey läuft immer mit; Passwort Pflicht: openssl rand -hex 32
VALKEY_PASSWORD=
VALKEY_MAXMEMORY=256mb
# Ressourcen-Limits (docker compose deploy.resources.limits)
API_CPUS=2
API_MEMORY=1g
DB_CPUS=2
DB_MEMORY=1g
VALKEY_CPUS=1
VALKEY_MEMORY=384m
# Threads zählen als PIDs (≈ WEB_CONCURRENCY × (THREADPOOL_SIZE + 10))
API_PIDS_LIMIT=1024
# je Worker: Threadpool (sync-Endpunkte/DB), gleichzeitige PDF-Erzeugungen; weitere PDF-Anfragen warten
# höchstens PDF_WAIT_S (≤ 1 s) und nur bis PDF_QUEUE wartende, sonst sofort 503 + Retry-After
THREADPOOL_SIZE=40
PDF_CONCURRENCY=2
PDF_WAIT_S=1
PDF_QUEUE=4
# Rollback auf ein älteres Image nach einer Migration: diese neueren Revisionen als kompatibel zulassen
# (kommagetrennt, "*" = jede unbekannte neuere). Sonst /health/ready 503 und migrate bricht ab.
SCHEMA_COMPATIBLE_NEWER=
# Worker nach N Anfragen ersetzen (0 = nie; nur bei > 1 Worker; Jitter 10 %)
UVICORN_LIMIT_MAX_REQUESTS=0
# SIGTERM: laufende Anfragen so lange fertigstellen (Sekunden)
GRACEFUL_TIMEOUT_S=25
# DB-Pool JE WORKER; Startprüfung: WEB_CONCURRENCY × (POOL + OVERFLOW) + DB_CONNECTION_RESERVE ≤ PG_MAX_CONNECTIONS
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECTION_RESERVE=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# PgBouncer (transaction mode) zwischen API und DB: 1 setzen (psycopg ohne Prepared Statements)
DB_DISABLE_PREPARED=0
# Prometheus: GET /metrics nur mit "Authorization: Bearer <METRICS_TOKEN>" (≥ 32 Zeichen) oder aus METRICS_ALLOW
METRICS_TOKEN=
METRICS_ALLOW=

# PostgreSQL-Tuning (docker-compose: postgres -c …). Defaults = ≈ 1 GB RAM für die DB.
# Richtwerte (DB_MEMORY / PG_SHM_SIZE ≥ shared_buffers):
#   RAM DB | max_conn | shared_buffers | eff_cache_size | work_mem | maint_work_mem | wal_buffers | worker/parallel/gather
#   1 GB   |   100    |  256MB         |  768MB         |  4MB     |   64MB         |   8MB       |  8 / 2 / 1
#   8 GB   |   200    |  2GB           |  6GB           |  16MB    |  512MB         |  16MB       |  8 / 4 / 2
#   16 GB  |   300    |  4GB           |  12GB          |  24MB    |  1GB           |  16MB       | 16 / 8 / 4
#   32 GB  |   400    |  8GB           |  24GB          |  32MB    |  2GB           |  16MB       | 16 / 12 / 4
# Beispiel 32-Kern-EPYC, Docker-VM 128 GB: DB_MEMORY=32g, DB_CPUS=12, PG_*-Zeile „32 GB“, PG_SHM_SIZE=8g;
#   API_CPUS=16, API_MEMORY=16g, WEB_CONCURRENCY=auto (→ 16), DB_POOL_SIZE=10, DB_MAX_OVERFLOW=10
#   → 16 × 20 + 10 = 330 ≤ PG_MAX_CONNECTIONS=400. Mehr Verbindungen nur mit PgBouncer (DB_DISABLE_PREPARED=1).
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_WAL_BUFFERS=8MB
PG_MAX_WORKER_PROCESSES=8
PG_MAX_PARALLEL_WORKERS=2
PG_MAX_PARALLEL_WORKERS_PER_GATHER=1
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=1
PG_MAX_WAL_SIZE=1GB
PG_SHM_SIZE=256mb

# Keycloak
OIDC_ISSUER=https://id.j-mb.net/realms/<realm>
OIDC_CLIENT_ID=fahrzeugbuch-ios
# Web-Frontend (öffentlicher Client, PKCE); immer als azp zugelassen.
# Nur dort: Mitgliederverwaltung und Steuerparameter
OIDC_WEB_CLIENT_ID=fahrzeugbuch-web
# optional: zusätzlich aud prüfen (Audience-Mapper nötig)
OIDC_AUDIENCE=
# optional: weitere Clients (Komma-getrennt), z. B. für Skripte
OIDC_ALLOWED_AZP=
OIDC_REQUIRED_ROLE=fahrzeugbuch-user

# Mandanten aus Keycloak-Gruppen: /fahrzeugbuch/<mandant> (schreiben), /fahrzeugbuch/<mandant>/lesen,
# /fahrzeugbuch/<mandant>/admin (verwalten inkl. schreiben)
TENANT_GROUP_PREFIX=/fahrzeugbuch/
# nur Einzelbetrieb; dann OIDC_REQUIRED_ROLE setzen!
DEFAULT_TENANT=

# Mitgliederverwaltung über die Keycloak-Admin-API (optional; leer = nur Anzeige der Akteure aus dem Journal)
# Service-Account-Client anlegen: keycloak/setup-client.sh mit CREATE_ADMIN_API=1 (gibt das Secret aus)
# Basis-URL von Keycloak; leer → aus OIDC_ISSUER
KC_ADMIN_URL=
# Realm der Benutzer/Gruppen; leer → aus OIDC_ISSUER
KC_ADMIN_REALM=
KC_ADMIN_CLIENT_ID=
KC_ADMIN_CLIENT_SECRET=
# Timeout je Anfrage an die Admin-API (Sekunden)
KC_ADMIN_TIMEOUT_S=5

# Revisionssicherheit: Ed25519-Schlüssel für signierte Kettenanker und den Prüfstand (NICHT in der DB ablegen)
# PFLICHT (docker compose bricht ohne ab); erzeugen: openssl rand -base64 32 – sicher aufbewahren (Backup!)
ANCHOR_SIGNING_KEY=
# nach einem Schlüsselwechsel: alte Public Keys (Base64, raw 32 Byte, kommagetrennt), damit alte Anker gültig
# bleiben; Public Key des aktuellen Schlüssels: GET /api/t/<mandant>/audit/anchors → public_key
ANCHOR_PUBLIC_KEYS=
ANCHOR_INTERVAL_MIN=60
# Integritätsprüfung (PDF, /audit/verify) inkrementell ab dem bestätigten Prüfstand je Mandant (verify_checkpoints,
# mit ANCHOR_SIGNING_KEY signiert); Vollprüfung, wenn die letzte älter als diese Zeit (Sekunden) ist, bzw. ?full=1
VERIFY_FULL_INTERVAL_S=86400
# Zeitzone für Monatszuordnung, Monatsabschluss und Berichte
APP_TIMEZONE=Europe/Zurich

MAX_BODY_BYTES=1048576
# Belegspeicher: fs (Volume fahrzeugbuch-files) | s3 (S3-kompatibel: MinIO, Ceph RGW, AWS …)
STORAGE_BACKEND=fs
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=attachments/
S3_FORCE_PATH_STYLE=1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Belege (Fotos/PDF, PUT …/attachments/{id}/blob): eigenes Body-Limit, max. 8 MiB
# Reverse Proxy (Caddy/OPNsense) muss Bodies dieser Grösse durchlassen
MAX_UPLOAD_BYTES=8388608
# Speicherkontingent für Belege je Mandant (MB); überschritten → 507
ATTACHMENT_QUOTA_MB=2048
DOCS_ENABLED=0

# ---------- Intelligente Dienste (optional, leer = aus) ----------
# Die API ist im internen Netz und im default-Netz; externe Container per Host-IP
# oder http://host.docker.internal:<port> (Port auf dem Docker-Host veröffentlicht).
# OSRM (Map-Matching/Route), z. B. http://host.docker.internal:5000
OSRM_URL=
OSRM_PROFILE=driving
# max. Punkte je /match-Anfrage, muss zu osrm-routed --max-matching-size passen
OSRM_MAX_MATCHING_SIZE=100
# Photon (Reverse-Geocoding); mit Compose-Profil "geo": http://photon:2322
PHOTON_URL=
# vLLM (OpenAI-kompatibel), z. B. http://host.docker.internal:8000/v1
VLLM_URL=
VLLM_MODEL=qwen3.5-9b
# nur falls vLLM mit --api-key gestartet wurde
VLLM_API_KEY=
# Bildauswertung von Belegen (Zapfsäule/Quittung/Tacho) mit einem Vision-Modell
# URL leer → VLLM_URL; Modell leer → Bildauswertung aus
VLLM_VISION_URL=
VLLM_VISION_MODEL=
# Timeouts in Sekunden
GEO_TIMEOUT_S=5
LLM_TIMEOUT_S=10
# Rate-Limits je Benutzer und Minute
INTEL_RATE_SUGGEST=60
INTEL_RATE_GEO=30
INTEL_RATE_SCAN=20
# je Benutzer und Minute: PDF/CSV/Jahresbericht, Integritätsprüfung, Vollabgleich (/changes?since=0)
RATE_REPORTS=20
RATE_VERIFY=10
RATE_FULL_SYNC=10
# je Benutzer und Minute: Aktivitäts-Feed, Mitgliederliste/-änderungen
RATE_ACTIVITY=60
RATE_MEMBERS=30
# je Dienst (OSRM, Photon, LLM, Vision, Keycloak-Admin): gleichzeitige Anfragen (voll → sofort 503) und Circuit-Breaker
UPSTREAM_CONCURRENCY=4
UPSTREAM_BREAKER_FAILURES=3
UPSTREAM_BREAKER_OPEN_S=30
# n8n-Webhook (z. B. Monat abgeschlossen → Paperless); folgt keinen Weiterleitungen
N8N_WEBHOOK_URL=
# Signatur: Header X-Fahrzeugbuch-Signature = "sha256=" + HMAC-SHA256(Secret, Body) – in n8n prüfen
# erzeugen: openssl rand -hex 32 (mind. 32 Zeichen, sonst Startwarnung)
N8N_WEBHOOK_SECRET=
# Kanton für Steuerparameter, z. B. ZH
TAX_CANTON=
