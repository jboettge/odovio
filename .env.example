# Passwort erzeugen: openssl rand -hex 32
DB_PASSWORD=
API_PORT=8085

# Keycloak
OIDC_ISSUER=https://id.j-mb.net/realms/<realm>
OIDC_CLIENT_ID=fahrzeugbuch-ios
# optional: aud-Prüfung statt azp (Audience-Mapper im Client nötig)
OIDC_AUDIENCE=
# optional: Realm-/Client-Rolle oder Gruppe, z. B. fahrzeugbuch-user
OIDC_REQUIRED_ROLE=fahrzeugbuch-user
