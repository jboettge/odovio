{
  "name": "fahrzeugbuch-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web-Frontend für das Fahrzeugbuch (Vue 3 + TypeScript + Vite)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "mock:large": "node mock/server.mjs --seed large",
    "dev:mock": "node mock/server.mjs --port 8787 & vite",
    "build": "vite build && node scripts/compress.mjs dist",
    "size": "node scripts/size.mjs dist",
    "preview": "node mock/server.mjs --static dist --port 4319",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "e2e:perf": "playwright test --trace off --project perf",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "budgets": {
    "startJsGzipKiB": 72,
    "dashboardJsGzipKiB": 85,
    "cssGzipKiB": 8,
    "chunkJsGzipKiB": 32,
    "workerJsGzipKiB": 8
  },
  "dependencies": {
    "oidc-client-ts": "3.5.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
