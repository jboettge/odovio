{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fahrzeugbuch Helm-Values",
  "type": "object",
  "required": ["image", "config", "database", "storage", "secrets", "resources"],
  "definitions": {
    "quantity": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"},
        {"type": "number", "exclusiveMinimum": 0}
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}},
        "limits": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}}
      }
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "egressTarget": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "cidrs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
        "namespaceSelector": {"type": "object"},
        "podSelector": {"type": "object"},
        "ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/port"}}
      },
      "required": ["ports"],
      "additionalProperties": false
    },
    "envName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
  },
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": ["string", "number"]},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "webConcurrency": {
      "anyOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^(auto|[1-9][0-9]*)$"}
      ]
    },
    "stateBackend": {"enum": ["memory", "redis"]},
    "strictBudget": {"type": "boolean"},
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": {"enum": ["auto", "RollingUpdate", "Recreate"]},
        "maxSurge": {"type": "integer", "minimum": 0},
        "maxUnavailable": {"type": "integer", "minimum": 0}
      }
    },
    "hpa": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000},
        "targetMemoryUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000},
        "customMetrics": {"type": "array"},
        "behavior": {"type": "object"}
      }
    },
    "vpa": {
      "type": "object",
      "required": ["enabled", "updateMode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "updateMode": {"enum": ["Off", "Initial", "Recreate", "InPlaceOrRecreate", "Auto"]},
        "controlledResources": {"type": "array", "items": {"enum": ["cpu", "memory"]}, "minItems": 1, "uniqueItems": true},
        "controlledValues": {"enum": ["RequestsAndLimits", "RequestsOnly"]},
        "minAllowed": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}},
        "maxAllowed": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}},
        "minReplicas": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]},
        "unhealthyPodEvictionPolicy": {"enum": ["AlwaysAllow", "IfHealthyBudget", ""]}
      }
    },
    "config": {
      "type": "object",
      "required": ["OIDC_ISSUER"],
      "propertyNames": {"$ref": "#/definitions/envName"},
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]},
      "properties": {
        "OIDC_ISSUER": {"type": "string", "pattern": "^(https://.+)?$"},
        "STRICT_CONFIG": {"enum": ["0", "1", 0, 1]},
        "FORCE_HSTS": {"enum": ["0", "1", 0, 1]},
        "DOCS_ENABLED": {"enum": ["0", "1", 0, 1]},
        "LOG_LEVEL": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]},
        "WEB_CONCURRENCY": {"not": {}},
        "STATE_BACKEND": {"not": {}},
        "STORAGE_BACKEND": {"not": {}},
        "AUTO_MIGRATE": {"not": {}},
        "DATABASE_URL": {"not": {}},
        "REDIS_URL": {"not": {}},
        "FILES_DIR": {"not": {}},
        "GRACEFUL_TIMEOUT_S": {"not": {}},
        "PG_MAX_CONNECTIONS": {"not": {}},
        "REPLICAS_HINT": {"not": {}},
        "DB_CONNECTION_RESERVE": {"not": {}},
        "DB_POOL_SIZE": {"not": {}},
        "DB_MAX_OVERFLOW": {"not": {}}
      }
    },
    "checklistTemplates": {"type": "string"},
    "extraEnv": {"type": "array"},
    "secrets": {
      "type": "object",
      "required": ["useFileEnv", "mountPath"],
      "properties": {
        "existingSecret": {"type": "string"},
        "existingSecretKeys": {"type": "array", "items": {"$ref": "#/definitions/envName"}, "uniqueItems": true},
        "values": {
          "type": "object",
          "properties": {
            "METRICS_TOKEN": {"type": ["string", "null"], "pattern": "^(.{32,})?$"},
            "N8N_WEBHOOK_SECRET": {"type": ["string", "null"], "pattern": "^(.{32,})?$"}
          },
          "propertyNames": {"$ref": "#/definitions/envName"},
          "additionalProperties": {"type": ["string", "null"]}
        },
        "mountPath": {"type": "string", "pattern": "^/"},
        "useFileEnv": {"type": "boolean"}
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "sslmode", "ownerUser", "appUser", "pool", "maxConnections"],
      "properties": {
        "host": {"type": "string"},
        "port": {"$ref": "#/definitions/port"},
        "migrationHost": {"type": "string"},
        "migrationPort": {"anyOf": [{"$ref": "#/definitions/port"}, {"type": "null"}]},
        "name": {"type": "string", "minLength": 1},
        "sslmode": {"enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]},
        "driver": {"type": "string", "pattern": "^postgresql(\\+[a-z0-9]+)?$"},
        "extraParams": {"type": "object"},
        "ownerUser": {"type": "string", "minLength": 1},
        "appUser": {"type": "string", "minLength": 1},
        "ownerPassword": {"type": "string"},
        "appPassword": {"type": "string"},
        "existingSecret": {"type": "string"},
        "existingOwnerSecret": {"type": "string"},
        "appPasswordKey": {"type": "string", "minLength": 1},
        "ownerPasswordKey": {"type": "string", "minLength": 1},
        "disablePreparedStatements": {"type": "boolean"},
        "pool": {
          "type": "object",
          "required": ["size", "maxOverflow"],
          "properties": {
            "size": {"type": "integer", "minimum": 1},
            "maxOverflow": {"type": "integer", "minimum": 0}
          }
        },
        "maxConnections": {"type": "integer", "minimum": 10},
        "reservedConnections": {"type": "integer", "minimum": 0}
      }
    },
    "storage": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": {"enum": ["fs", "s3"]},
        "fs": {
          "type": "object",
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "existingClaim": {"type": "string"},
                "storageClass": {"type": "string"},
                "accessModes": {
                  "type": "array", "minItems": 1,
                  "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"]}
                },
                "size": {"$ref": "#/definitions/quantity"},
                "retain": {"type": "boolean"}
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string", "pattern": "^(https?://.+)?$"},
            "bucket": {"type": "string"},
            "region": {"type": "string"},
            "prefix": {"type": "string"},
            "forcePathStyle": {"type": "boolean"},
            "existingSecret": {"type": "string"},
            "accessKeyIdKey": {"type": "string"},
            "secretAccessKeyKey": {"type": "string"},
            "accessKeyId": {"type": "string"},
            "secretAccessKey": {"type": "string"}
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "password": {"type": "string"},
            "existingSecret": {"type": "string"},
            "existingSecretKey": {"type": "string", "minLength": 1}
          }
        },
        "database": {"type": "integer", "minimum": 0, "maximum": 15},
        "maxmemory": {"type": "string", "pattern": "^[0-9]+(kb|mb|gb)?$"},
        "maxmemoryPolicy": {"enum": ["noeviction", "allkeys-lru", "volatile-lru", "allkeys-lfu", "volatile-lfu", "allkeys-random", "volatile-random", "volatile-ttl"]},
        "disabledCommands": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+$"}},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "url": {"type": "string", "pattern": "^(rediss?://[^:@]+(:[0-9]+)?(/[0-9]+)?)?$"},
        "existingSecret": {"type": "string"},
        "passwordKey": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hookWeight": {"type": "integer"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "resources": {"$ref": "#/definitions/resources"},
    "gracefulTimeoutSeconds": {"type": "integer", "minimum": 1},
    "preStopSleepSeconds": {"type": "integer", "minimum": 0},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1}
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {"const": false},
        "privileged": {"const": false},
        "readOnlyRootFilesystem": {"type": "boolean"}
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"$ref": "#/definitions/port"}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": ["object", "null"]},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": {"type": "string", "pattern": "^[a-z0-9*]([a-z0-9.-]*[a-z0-9])?$"},
              "paths": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": {"type": "string", "pattern": "^/"},
                    "pathType": {"enum": ["Prefix", "Exact", "ImplementationSpecific"]}
                  }
                }
              }
            }
          }
        },
        "tls": {"type": "array"},
        "traefikMiddleware": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "maxRequestBodyBytes": {"type": "integer", "minimum": 1048576},
            "memRequestBodyBytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "parentRefs": {"type": "array"},
        "hostnames": {"type": "array", "items": {"type": "string"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "egress": {
          "type": "object",
          "properties": {
            "database": {"$ref": "#/definitions/egressTarget"},
            "redis": {"$ref": "#/definitions/egressTarget"},
            "s3": {"$ref": "#/definitions/egressTarget"},
            "oidc": {"$ref": "#/definitions/egressTarget"},
            "extra": {"type": "array", "items": {"$ref": "#/definitions/egressTarget"}}
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "path": {"type": "string", "pattern": "^/"}
      }
    }
  }
}
